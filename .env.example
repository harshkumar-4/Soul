# Official public configuration
NEXT_PUBLIC_SITE_URL=https://www.soulfuli.org
SOULFULI_CONTACT_EMAIL=soulfuli.global@gmail.com

# Transactional Email Delivery (Resend) — Required for enquiry & newsletter delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Soulfuli <onboarding@resend.dev>

# Optional: Supabase Server Persistence (Server-only, never expose SERVICE_ROLE in client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Webhook fallback if not using Resend/Supabase directly
ENQUIRY_WEBHOOK_URL=

